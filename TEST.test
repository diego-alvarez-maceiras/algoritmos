# 1. Creación e carga de nodos
CREATE '{"name": "ISS", "agency": "International", "orbit_type": "LEO", "launch_year": 1998, "x": 4200.0, "y": 3800.0, "z": 3400.0, "transmitter_power_w": 2500.0, "status": "Active", "description": "International Space Station"}'
LOAD data.json 200000

# 2. Consultas e impresión do estado inicial
FIND ISS
PRINT

# 3. Proba de percorridos (BFS e DFS)
TRAVEL ISS WIDTH
TRAVEL ISS DEPTH

# 4. Cálculo de camiños máis curtos (Dijkstra)
PATH ISS Hubble

# 5. Análise de conectividade e puntos críticos
COMPONENTS
FIND_CUT_VERTICES

# 6. Modificación de arestas (Conexión e Desconexión)
CONNECT ISS Hubble 1500.0
PATH ISS Hubble
DISCONNECT ISS Hubble

# 7. Modificación de nodos e re-exploración do grafo
REMOVE Hubble
PRINT
COMPONENTS
FIND_CUT_VERTICES